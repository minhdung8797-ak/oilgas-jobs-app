# ─────────────────────────── DATABASE ───────────────────────────
POSTGRES_USER=ogjobs
POSTGRES_PASSWORD=ogjobs_password
POSTGRES_DB=ogjobs
DATABASE_URL="postgresql://ogjobs:ogjobs_password@localhost:5432/ogjobs?schema=public&connection_limit=10&pool_timeout=20"

# ─────────────────────────── REDIS (BullMQ queue) ───────────────
REDIS_URL="redis://localhost:6379"
QUEUE_ENABLED=true

# ─────────────────────────── API ────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
# Bearer token bắt buộc cho các endpoint quản trị (/scrape/run, /classify/rebuild)
ADMIN_API_KEY=change-me-super-secret
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ─────────────────────────── SCRAPER ────────────────────────────
SCRAPER_ENABLED=true
SCRAPER_CONCURRENCY=3
SCRAPER_MAX_PAGES=8
SCRAPER_REQUEST_DELAY_MS=1500
SCRAPER_TIMEOUT_MS=45000
SCRAPER_USER_AGENT="OGJobsBot/1.0 (+https://example.com/bot; contact@example.com)"
SCRAPER_RESPECT_ROBOTS=true
PLAYWRIGHT_HEADLESS=true
# Proxy tùy chọn: http://user:pass@host:port
PROXY_URL=

# ─────────────────────────── CRON ───────────────────────────────
CRON_ENABLED=true
# 03:15 UTC mỗi ngày
CRON_SCRAPE_ALL="15 3 * * *"
# 04:30 UTC mỗi ngày - đánh dấu hết hạn job cũ
CRON_EXPIRE="30 4 * * *"
# 05:00 UTC mỗi ngày - refresh tỉ giá
CRON_FX="0 5 * * *"
JOB_TTL_DAYS=60

# ─────────────────────────── NLP ────────────────────────────────
# Ngưỡng điểm rule-based để chấp nhận nhãn
CLASSIFIER_MIN_SCORE=6
CLASSIFIER_MIN_MARGIN=2
# Bật HuggingFace zero-shot fallback cho case mơ hồ
HF_ENABLED=false
HF_API_TOKEN=
HF_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
HF_TIMEOUT_MS=15000

# ─────────────────────────── FX ─────────────────────────────────
FX_API_URL=https://api.exchangerate.host/latest?base=USD

# ─────────────────────────── FRONTEND ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_NAME="OilGas Jobs Radar"
# Chỉ dùng khi frontend chạy trong container và gọi API qua mạng nội bộ Docker.
# Để trống khi chạy pnpm dev trên máy.
# API_INTERNAL_URL=http://api:4000/api/v1
