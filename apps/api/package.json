{
  "name": "@og/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only src/scripts/seed.ts",
    "scrape": "ts-node --transpile-only src/scripts/scrape-cli.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "eval": "ts-node --transpile-only src/scripts/classifier-eval.ts",
    "seed:prod": "node dist/scripts/seed.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only src/scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/throttler": "6.2.1",
    "@og/shared": "workspace:*",
    "@prisma/client": "5.20.0",
    "axios": "1.7.7",
    "cheerio": "1.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "compression": "1.7.4",
    "cron": "3.1.7",
    "helmet": "7.1.0",
    "nestjs-pino": "4.1.0",
    "pino-http": "10.3.0",
    "pino-pretty": "11.2.2",
    "playwright": "1.47.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.4",
    "@types/compression": "1.7.5",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.10",
    "jest": "29.7.0",
    "prisma": "5.20.0",
    "source-map-support": "0.5.21",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4"
  }
}
