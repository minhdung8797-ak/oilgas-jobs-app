// ─────────────────────────────────────────────────────────────
//  OG Jobs – Prisma schema
//  DB: PostgreSQL 16
//  Chạy: pnpm db:migrate  (dev)  |  pnpm db:deploy (prod)
// ─────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── ENUMS ─────────────────────────

enum Discipline {
  RESERVOIR
  PETROLEUM
  PRODUCTION
  GEOSCIENCE
  OTHER
}

enum Seniority {
  INTERN
  ENTRY
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  GRADUATE
  UNKNOWN
}

enum WorkMode {
  ONSITE
  OFFSHORE
  REMOTE
  HYBRID
  ROTATIONAL
  UNKNOWN
}

enum CompanyType {
  IOC
  NOC
  SERVICE
  EPC
  CONSULTANCY
  JOB_BOARD
  OTHER
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum ScrapeStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SkillCategory {
  SOFTWARE
  DOMAIN
  PROGRAMMING
  CERTIFICATION
  SOFT
}

// ──────────────────────────── MODELS ─────────────────────────

model Country {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // ISO alpha-2
  iso3      String   @db.VarChar(3)
  name      String   @db.VarChar(120)
  region    String?  @db.VarChar(60)
  currency  String?  @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")

  jobs      Job[]
  companies Company[]

  @@index([region])
  @@map("countries")
}

model Company {
  id           String      @id @default(uuid()) @db.Uuid
  slug         String      @unique @db.VarChar(160)
  name         String      @db.VarChar(200)
  type         CompanyType @default(OTHER)
  website      String?     @db.VarChar(300)
  careersUrl   String?     @map("careers_url") @db.VarChar(400)
  logoUrl      String?     @map("logo_url") @db.VarChar(400)
  description  String?     @db.Text
  hqCountryId  Int?        @map("hq_country_id")
  jobCount     Int         @default(0) @map("job_count")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  hqCountry Country? @relation(fields: [hqCountryId], references: [id], onDelete: SetNull)
  jobs      Job[]

  @@index([name])
  @@index([type])
  @@map("companies")
}

model Skill {
  id        Int           @id @default(autoincrement())
  slug      String        @unique @db.VarChar(80)
  name      String        @db.VarChar(120)
  category  SkillCategory @default(DOMAIN)
  createdAt DateTime      @default(now()) @map("created_at")

  jobs JobSkill[]

  @@index([category])
  @@map("skills")
}

model Job {
  id        String @id @default(uuid()) @db.Uuid
  /// slug SEO: "senior-reservoir-engineer-slb-abu-dhabi-a1b2c3"
  slug      String @unique @db.VarChar(220)

  // ── Nguồn ──
  source     String  @db.VarChar(60) // rigzone | slb | bakerhughes ...
  sourceUrl  String  @unique @map("source_url") @db.VarChar(700)
  externalId String? @map("external_id") @db.VarChar(160)

  // ── Nội dung ──
  title           String  @db.VarChar(400)
  titleNormalized String  @map("title_normalized") @db.VarChar(400)
  description     String? @db.Text
  descriptionHtml String? @map("description_html") @db.Text

  // ── Quan hệ ──
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  countryId Int?     @map("country_id")
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  city        String? @db.VarChar(160)
  locationRaw String? @map("location_raw") @db.VarChar(300)

  // ── Phân loại NLP ──
  discipline           Discipline @default(OTHER)
  disciplineConfidence Float      @default(0) @map("discipline_confidence")
  disciplineScores     Json?      @map("discipline_scores")
  classifierVersion    String?    @map("classifier_version") @db.VarChar(40)
  matchedKeywords      String[]   @map("matched_keywords")

  // ── Thuộc tính chuẩn hóa ──
  seniority          Seniority      @default(UNKNOWN)
  employmentType     EmploymentType @default(UNKNOWN) @map("employment_type")
  workMode           WorkMode       @default(UNKNOWN) @map("work_mode")
  rotation           String?        @db.VarChar(40) // "28/28"
  experienceMinYears Int?           @map("experience_min_years")

  // ── Lương ──
  salaryMin      Decimal?      @map("salary_min") @db.Decimal(14, 2)
  salaryMax      Decimal?      @map("salary_max") @db.Decimal(14, 2)
  salaryCurrency String?       @map("salary_currency") @db.VarChar(3)
  salaryPeriod   SalaryPeriod? @map("salary_period")
  salaryMinUsd   Decimal?      @map("salary_min_usd") @db.Decimal(14, 2) // đã quy đổi về USD/năm
  salaryMaxUsd   Decimal?      @map("salary_max_usd") @db.Decimal(14, 2)

  // ── Vòng đời ──
  postedAt    DateTime? @map("posted_at")
  expiresAt   DateTime? @map("expires_at")
  scrapedAt   DateTime  @default(now()) @map("scraped_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  isActive    Boolean   @default(true) @map("is_active")
  contentHash String    @map("content_hash") @db.VarChar(64)
  raw         Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills JobSkill[]

  // Index phục vụ filter + sort chính của /jobs
  @@index([discipline, isActive, postedAt(sort: Desc)])
  @@index([countryId, discipline, isActive])
  @@index([companyId, isActive])
  @@index([source, scrapedAt])
  @@index([postedAt(sort: Desc)])
  @@index([salaryMaxUsd(sort: Desc)])
  @@index([contentHash])
  @@map("jobs")
}

model JobSkill {
  jobId   String @map("job_id") @db.Uuid
  skillId Int    @map("skill_id")
  weight  Float  @default(1)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model ScrapeRun {
  id         String       @id @default(uuid()) @db.Uuid
  source     String       @db.VarChar(60)
  status     ScrapeStatus @default(RUNNING)
  startedAt  DateTime     @default(now()) @map("started_at")
  finishedAt DateTime?    @map("finished_at")
  durationMs Int?         @map("duration_ms")
  found      Int          @default(0)
  inserted   Int          @default(0)
  updated    Int          @default(0)
  skipped    Int          @default(0)
  failed     Int          @default(0)
  errors     Json?
  triggeredBy String      @default("cron") @map("triggered_by") @db.VarChar(40)

  @@index([source, startedAt(sort: Desc)])
  @@index([status])
  @@map("scrape_runs")
}

model FxRate {
  code      String   @id @db.VarChar(3)
  rateToUsd Decimal  @map("rate_to_usd") @db.Decimal(18, 8) // 1 USD = rateToUsd <code>
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("fx_rates")
}
