{
  "name": "og-jobs",
  "private": true,
  "version": "1.0.0",
  "description": "International Oil & Gas job aggregator - Reservoir / Petroleum / Production / Geoscience & Formation",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @og/shared build && pnpm -r --filter @og/api build && pnpm -r --filter @og/web build",
    "dev": "pnpm --filter @og/shared build && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @og/api dev",
    "dev:web": "pnpm --filter @og/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @og/api prisma:generate",
    "db:migrate": "pnpm --filter @og/api prisma:migrate",
    "db:deploy": "pnpm --filter @og/api prisma:deploy",
    "db:seed": "pnpm --filter @og/api prisma:seed",
    "db:studio": "pnpm --filter @og/api prisma:studio",
    "scrape": "pnpm --filter @og/api scrape",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "prettier": "3.3.3",
    "rimraf": "6.0.1"
  }
}
